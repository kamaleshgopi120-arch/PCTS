# ==============================================================
# Environment Configuration Template (.env.example)
# ==============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to Git!
# ==============================================================

# Database Connection Settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=pcts_db

# Full SQLAlchemy Database URL format:
# mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/pcts_db

# Security & JWT Authentication (Phase 10)
# Use a strong, random 256-bit string in production
JWT_SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
